{
  "name": "telegram-info-api",
  "version": "1.0.0",
  "description": "A lightweight Express.js API to scrape and convert public Telegram channel/user profile information into JSON format using Linkedom.",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "serverless": "node src/app.js"
  },
  "keywords": [],
  "author": "Taraknath Karan",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.2.1",
    "linkedom": "0.18.12"
  }
}
